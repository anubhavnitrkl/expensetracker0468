rules_version = '2';

// Expense Tracker: only the Google accounts listed below can read or write.
// Replace the two example addresses with your Gmail and your wife's Gmail
// (lowercase), then paste this whole file into Firestore > Rules and Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'your.name@gmail.com',
             'wife.name@gmail.com'
           ];
    }

    // Household settings: categories, payment modes, recurring bills
    match /households/family {
      allow read, write: if isFamily();

      // One document per month (e.g. 2026-11) holding that month's expenses
      match /months/{month} {
        allow read, write: if isFamily() && month.matches('^[0-9]{4}-[0-9]{2}$');
      }
    }

    // Everything else stays locked
  }
}
